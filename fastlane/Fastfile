# frozen_string_literal: true

require "base64"
require "English"
require "json"
require "net/http"
require "securerandom"
require "tempfile"
require "timeout"
require "uri"
require_relative "lib/release_config"
require_relative "lib/sdk_release"

desc "Release HXSDK from a source tag and prepare adapter releases for its version"
lane :release_sdk do |options|
  SDKRelease::Runner.new(SDKRelease::Request.new(options)).run
rescue SDKRelease::Error => e
  UI.user_error!(e.message)
end

def release_context(options)
  project_root = File.expand_path(options[:project_root].to_s)
  config_path = options[:config_path].to_s
  config_path = File.join(project_root, ".github", "release.yml") if config_path.empty?
  config_path = File.expand_path(config_path)
  config = CentralRelease.load_config(config_path)
  CentralRelease.validate!(config, project_root: project_root)
  pubspec = CentralRelease.load_pubspec(project_root)
  CentralRelease.validate_pubspec!(config, pubspec)
  [project_root, config, pubspec]
rescue CentralRelease::ConfigurationError => e
  UI.user_error!(e.message)
end

def git_value(project_root, *arguments)
  command = ["git", "-C", project_root, *arguments]
  value = IO.popen(command, &:read).strip
  UI.user_error!("Git 命令执行失败: #{CentralRelease.shell_join(command)}") unless $CHILD_STATUS.success?
  value
end

def app_store_connect_api_key_from(pubspec)
  key_id = pubspec["appstore_api_key"].to_s.strip
  issuer_id = pubspec["appstore_api_issuer"].to_s.strip
  key_content = pubspec["appstore_base64_content"].to_s.strip
  UI.user_error!("pubspec.yaml 缺少 appstore_api_key") if key_id.empty?
  UI.user_error!("pubspec.yaml 缺少 appstore_api_issuer") if issuer_id.empty?
  UI.user_error!("pubspec.yaml 缺少 appstore_base64_content") if key_content.empty?

  Tempfile.create(["app_store_connect_api_key", ".p8"]) do |file|
    file.binmode
    file.write(Base64.strict_decode64(key_content))
    file.flush
    return app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: file.path,
      in_house: false
    )
  end
rescue ArgumentError
  UI.user_error!("pubspec.yaml 中 appstore_base64_content 不是有效的 Base64")
end

def record_testflight_failure(error)
  path = ENV["TESTFLIGHT_FAILURE_PATH"].to_s
  return if path.empty?

  message = error.message.encode("UTF-8", invalid: :replace, undef: :replace).strip
  summary = message.lines.first.to_s.strip[0, 600]
  return if summary.empty?

  File.write(path, JSON.generate(stage: "upload_to_testflight", summary: summary))
rescue SystemCallError, IOError => e
  UI.important("无法记录 TestFlight 错误摘要: #{e.class}")
end

def testflight_failure_summary
  path = ENV["TESTFLIGHT_FAILURE_PATH"].to_s
  return if path.empty? || !File.file?(path)

  failure = JSON.parse(File.read(path, encoding: "UTF-8"))
  return unless failure.is_a?(Hash) && failure["stage"] == "upload_to_testflight"

  summary = failure["summary"]
  summary if summary.is_a?(String) && !summary.strip.empty?
rescue JSON::ParserError, SystemCallError, IOError => e
  UI.important("无法读取 TestFlight 错误摘要: #{e.class}")
  nil
end

desc "Validate a target project's centralized release configuration"
lane :validate_config do |options|
  project_root, config, = release_context(options)
  CentralRelease.validate_runtime!(
    config,
    external_testing: options[:external_testing],
    changelog: options[:changelog]
  )
  enabled_platforms = %w[ios android].select { |platform| CentralRelease.enabled?(config[platform]) }
  UI.success("发布配置校验通过: #{project_root} (#{enabled_platforms.join(', ')})")
end

def native_asc_api_key(config)
  app_store_connect_api_key(
    key_id: config.fetch("ASC_KEY_ID"),
    issuer_id: config.fetch("ASC_ISSUER_ID"),
    key_content: config.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

def native_testflight_app(identifier)
  Spaceship::ConnectAPI::App.find(identifier) ||
    UI.user_error!("App Store Connect 找不到 #{identifier}")
end

def with_native_ios_signing(config, settings)
  NativeIOSRelease.required("MATCH_PASSWORD")
  signing = config.fetch("match")
  identifiers = config.fetch("signing_targets").values
  keychain = "native-ios-#{SecureRandom.hex(8)}"
  keychain_password = SecureRandom.hex(32)

  create_keychain(name: keychain, password: keychain_password, unlock: true, timeout: 3600,
                  default_keychain: false, add_to_search_list: true, require_create: true)
  keychain_path = FastlaneCore::Helper.keychain_path(keychain)

  NativeIOSRelease.with_git_ssh(signing.fetch("git_url"), label: "match.git_url") do |git_env|
    FastlaneCore::Helper.with_env_values(git_env) do
      match(
        type: "appstore", platform: "ios", readonly: true, app_identifier: identifiers,
        git_url: signing.fetch("git_url"), git_branch: signing.fetch("git_branch"),
        certificate_id: signing.fetch("certificate_id"), team_id: config.fetch("team_id"),
        keychain_name: keychain, keychain_password: keychain_password
      )
    end
  end
  ENV.delete("SSH_PRIVATE_KEY")
  ENV.delete("MATCH_PASSWORD")

  mapping = NativeIOSRelease.match_profile_names!(config, lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING])
  identities = NativeIOSRelease.capture!("security", "find-identity", "-v", "-p", "codesigning", keychain_path)
  fingerprints = identities.lines.grep(/"Apple Distribution:/).flat_map { |line| line.scan(/[A-F0-9]{40}/) }
  UI.user_error!("Match 未提供可用的 Apple Distribution 签名身份") if fingerprints.empty?

  selected_profiles = config.fetch("signing_targets").to_h do |target, identifier|
    path = native_match_profile_path(identifier)
    UI.user_error!("Match 未安装 #{identifier} 的描述文件") unless path && File.file?(path)

    profile = FastlaneCore::ProvisioningProfile.parse(path)
    entitlement_path = settings.fetch(target)["CODE_SIGN_ENTITLEMENTS"].to_s
    app_groups = if entitlement_path.empty?
                   []
                 else
                   path_to_entitlements = File.expand_path(entitlement_path, settings.fetch(target).fetch("SRCROOT"))
                   Array(NativeIOSRelease.plist(path_to_entitlements)["com.apple.security.application-groups"])
                 end
    uuid = NativeIOSRelease.validate_profile!(profile, identifier: identifier, team: config.fetch("team_id"),
                                               fingerprint_candidates: fingerprints, app_groups: app_groups)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(NativeIOSRelease.source_dir, config.fetch("project")),
      build_configurations: ["Release"],
      targets: [target],
      team_id: config.fetch("team_id"),
      code_sign_identity: "Apple Distribution",
      profile_name: mapping.fetch(identifier),
      profile_uuid: uuid
    )
    [identifier, uuid]
  end
  yield selected_profiles
ensure
  if identifiers && defined?(Match::Utils)
    identifiers.each do |identifier|
      path = native_match_profile_path(identifier)
      FileUtils.rm_f(path) if path && File.dirname(path) == FastlaneCore::ProvisioningProfile.profiles_path
    end
  end
  delete_keychain(name: keychain) if keychain_path && File.exist?(keychain_path)
end

def native_match_profile_path(identifier)
  ENV[Match::Utils.environment_variable_name_profile_path(app_identifier: identifier, type: "appstore", platform: "ios")]
end

platform :ios do
  desc "Archive and verify an App Store IPA for a registered native iOS project"
  lane :build_native_testflight do
    require_relative "lib/native_ios_release"
    config = NativeIOSRelease.project
    NativeIOSRelease.changelog
    group_selector = NativeIOSRelease.required("TESTFLIGHT_EXTERNAL_GROUP")
    branch = NativeIOSRelease.source_branch
    settings = NativeIOSRelease.build_settings(config)
    app_settings = settings.fetch(config.fetch("app_target"))
    version = app_settings.fetch("MARKETING_VERSION")
    UI.user_error!("MARKETING_VERSION 须为数字版本号") unless version.match?(/\A[0-9]+(?:\.[0-9]+){1,2}\z/)
    unless settings.values.all? { |target| target["MARKETING_VERSION"] == version }
      UI.user_error!("主 App 和扩展的 MARKETING_VERSION 必须一致")
    end
    identifier = app_settings.fetch("PRODUCT_BUNDLE_IDENTIFIER")

    api_key = native_asc_api_key(config)
    app = native_testflight_app(identifier)
    group = NativeIOSRelease.external_group!(app, group_selector)
    uploaded = latest_testflight_build_number(api_key: api_key, app_identifier: identifier,
                                              version: version, platform: "ios", initial_build_number: 0)
    build_number = NativeIOSRelease.next_build_number(app_settings.fetch("CURRENT_PROJECT_VERSION"), uploaded)
    source_sha, release_sha = NativeIOSRelease.commit_version!(config, version, build_number)

    artifact_name = "#{config.fetch('key')}-#{version}-#{build_number}-#{release_sha[0, 8]}"
    ipa = with_native_ios_signing(config, settings) do |selected_profiles|
      build_app(
        project: File.join(NativeIOSRelease.source_dir, config.fetch("project")),
        scheme: config.fetch("scheme"),
        configuration: "Release",
        destination: "generic/platform=iOS",
        archive_path: File.join(NativeIOSRelease.required("RUNNER_TEMP"), "native-ios.xcarchive"),
        derived_data_path: File.join(NativeIOSRelease.required("RUNNER_TEMP"), "native-ios-derived-data"),
        output_directory: NativeIOSRelease.output_dir,
        output_name: artifact_name,
        include_symbols: true,
        export_options: {
          method: "app-store-connect",
          teamID: config.fetch("team_id"),
          signingStyle: "manual",
          provisioningProfiles: selected_profiles,
          manageAppVersionAndBuildNumber: false
        }
      )
    end

    NativeIOSRelease.verify_ipa!(ipa, config, version, build_number)
    dsym = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    UI.user_error!("没有生成 dSYM 压缩包") unless dsym && File.file?(dsym)
    result = { source_sha: source_sha, release_sha: release_sha, branch: branch, version: version,
               build_number: build_number, artifact_name: artifact_name }
    File.write(NativeIOSRelease.metadata_path, JSON.generate(result.merge(ipa: ipa, identifier: identifier, testflight_group_id: group.id)))
    NativeIOSRelease.outputs(result)
  rescue LoadError, NativeIOSRelease::Error => e
    UI.user_error!(e.message)
  end

  desc "Upload the verified native iOS IPA and wait for Apple processing"
  lane :upload_native_testflight do
    require_relative "lib/native_ios_release"
    build = NativeIOSRelease.metadata
    upload_to_testflight(
      api_key: native_asc_api_key(NativeIOSRelease.project),
      app_identifier: build.fetch("identifier"),
      ipa: build.fetch("ipa"),
      skip_submission: true,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 1800
    )
  rescue LoadError, NativeIOSRelease::Error => e
    UI.user_error!(e.message)
  end

  desc "Distribute the exact uploaded version and build to the configured TestFlight group"
  lane :distribute_native_testflight do
    require_relative "lib/native_ios_release"
    build = NativeIOSRelease.metadata
    api_key = native_asc_api_key(NativeIOSRelease.project)
    app = native_testflight_app(build.fetch("identifier"))
    group = NativeIOSRelease.external_group!(app, build.fetch("testflight_group_id"))
    version = build.fetch("version")
    build_number = build.fetch("build_number").to_s
    upload_to_testflight(
      api_key: api_key,
      app_identifier: build.fetch("identifier"),
      app_platform: "ios",
      app_version: version,
      build_number: build_number,
      distribute_only: true,
      distribute_external: true,
      groups: [group.id],
      submit_beta_review: true,
      notify_external_testers: true,
      changelog: NativeIOSRelease.changelog
    )

    status = nil
    8.times do |attempt|
      current = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number,
                                                  platform: Spaceship::ConnectAPI::Platform.map("ios"), limit: 1).first
      if current && group.fetch_builds.any? { |assigned| assigned.id == current.id }
        status = NativeIOSRelease.beta_status(current.build_beta_detail)
        break if status
      end
      sleep(5) if attempt < 7
    end
    UI.user_error!("分发请求已发送，但尚无法验证外测组和审核状态，请在 TestFlight 检查 #{version} (#{build_number})") unless status

    NativeIOSRelease.outputs(status: status)
    UI.success(status)
  rescue LoadError, NativeIOSRelease::Error => e
    UI.user_error!(e.message)
  end

  desc "Build and upload the target iOS app to TestFlight"
  lane :release_beta do |options|
    setup_ci
    project_root, config, pubspec = release_context(options)
    ios = config.fetch("ios")
    unless CentralRelease.enabled?(ios)
      UI.message("项目未启用 iOS 发布，跳过")
      next
    end

    flavor = options[:flavor].to_s.empty? ? "production" : options[:flavor].to_s
    branch = git_value(project_root, "rev-parse", "--abbrev-ref", "HEAD")
    commit = git_value(project_root, "rev-parse", "--short", "HEAD")
    api_key = app_store_connect_api_key_from(pubspec)
    signing_configs = ios.fetch("bundle_identifiers")
    identifiers = signing_configs.map { |item| item.fetch("identifier") }
    match_config = ios.fetch("match")

    Dir.chdir(project_root) do
      command = CentralRelease.ios_flutter_command(
        config: config,
        flavor: flavor,
        branch: branch,
        commit: commit
      )
      UI.message("执行 iOS Flutter 构建: #{CentralRelease.shell_join(command)}")
      sh(*command)

      match_options = {
        type: match_config.fetch("type"),
        readonly: true,
        app_identifier: identifiers,
        git_url: match_config.fetch("git_url"),
        username: ios.fetch("apple_id"),
        team_id: ios.fetch("team_id"),
        api_key: api_key
      }
      match_options[:force_for_new_devices] = true if match_config["force_for_new_devices"] == true
      match(**match_options)

      provisioning_profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
      missing_profiles = identifiers.reject { |identifier| provisioning_profiles.key?(identifier) }
      unless missing_profiles.empty?
        UI.user_error!("match 未返回以下应用的 provisioning profile: #{missing_profiles.join(', ')}")
      end

      signing_configs.each do |signing_config|
        identifier = signing_config.fetch("identifier")
        update_code_signing_settings(
          use_automatic_signing: false,
          path: File.join(project_root, "ios", "Runner.xcodeproj"),
          team_id: ios.fetch("team_id"),
          code_sign_identity: "iPhone Distribution",
          profile_name: provisioning_profiles.fetch(identifier),
          targets: signing_config.fetch("targets"),
          bundle_identifier: identifier
        )
      end

      build_options = {
        workspace: File.join(project_root, "ios", "Runner.xcworkspace"),
        scheme: "Runner",
        export_options: {
          method: "app-store-connect",
          teamID: ios.fetch("team_id"),
          provisioningProfiles: provisioning_profiles
        }
      }
      if ios.fetch("archive_strategy") == "flutter_archive"
        build_options[:skip_build_archive] = true
        build_options[:archive_path] = File.join(project_root, "build", "ios", "archive", "Runner.xcarchive")
      else
        build_options[:xcargs] = "allowProvisioningUpdates=true"
      end
      build_app(**build_options)

      upload_options = CentralRelease.testflight_upload_options(
        config: config,
        requested: options[:external_testing],
        changelog: options[:changelog],
        api_key: api_key
      )
      if CentralRelease.truthy?(options[:external_testing]) && ios.dig("external_testing", "enabled") != true
        UI.message("当前项目未启用外部测试，按仅上传 TestFlight 处理")
      end
      begin
        upload_to_testflight(**upload_options)
      rescue Spaceship::ProgramLicenseAgreementUpdated => e
        record_testflight_failure(e)
        raise
      end
    end
  end
end

def try_native_play_version_code(project, key_path: nil)
  require "supply"
  Timeout.timeout(30) do
    key_path ||= NativeAndroidRelease.google_play_key_path(project)
    client = Supply::Client.make_from_config(params: { json_key: key_path })
    NativeAndroidRelease.latest_play_version_code(project.fetch("package_name"), client: client)
  end
rescue NativeAndroidRelease::Error, FastlaneCore::Interface::FastlaneError, Google::Apis::Error,
       Signet::AuthorizationError, Faraday::Error, Timeout::Error => error
  cause = error.cause || error
  status = cause.status_code if cause.respond_to?(:status_code)
  reason = status ? "HTTP #{status}" : cause.class.name
  UI.important("Google Play version lookup unavailable for #{project.fetch('package_name')} (#{reason}). Continuing with the local version code.")
  nil
end

platform :android do
  desc "Resolve the next native Android version code before packaging"
  lane :resolve_native_version_code do
    require_relative "lib/native_android_release"
    project = NativeAndroidRelease.project
    publish = ENV["UPLOAD_PRODUCTION"] == "true"
    uploaded = try_native_play_version_code(project) if publish
    lookup_unavailable = publish && uploaded.nil?
    current = NativeAndroidRelease.source_version_code(project)
    version = NativeAndroidRelease.next_version_code(ENV.fetch("VERSION_CODE"), uploaded || 0, current: current)
    File.open(ENV.fetch("GITHUB_ENV"), "a") do |file|
      file.puts("VERSION_CODE=#{version}", "PLAY_VERSION_LOOKUP_UNAVAILABLE=#{lookup_unavailable}")
    end
    play_version = publish ? (uploaded || "unavailable") : "not queried"
    UI.message("Android versionCode #{version} (source: #{current}, Google Play: #{play_version})")
  end

  desc "Upload a prebuilt native Android AAB to Google Play production"
  lane :upload_native_aab do
    require_relative "lib/native_android_release"
    project = NativeAndroidRelease.project
    version = Integer(ENV.fetch("VERSION_CODE"))
    key_path = NativeAndroidRelease.google_play_key_path(project)
    UI.user_error!("Signed AAB not found") unless File.file?(project.fetch("bundle"))

    unless ENV["PLAY_VERSION_LOOKUP_UNAVAILABLE"] == "true"
      uploaded = try_native_play_version_code(project, key_path: key_path)
    end
    if uploaded && version <= uploaded
      UI.user_error!("Google Play has reached versionCode #{uploaded}. Dispatch a new build to allocate a higher code.")
    end
    upload_options = {
      package_name: project.fetch("package_name"),
      track: "production",
      aab: project.fetch("bundle"),
      json_key: key_path,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    begin
      upload_to_play_store(**upload_options)
    rescue FastlaneCore::Interface::FastlaneError => error
      raise unless error.message.include?("Only releases with status draft may be created on draft app")

      UI.important("Google Play requires a draft release for this app. Retrying the production upload as a draft.")
      upload_to_play_store(
        **upload_options,
        release_status: "draft",
        changes_not_sent_for_review: true,
        rescue_changes_not_sent_for_review: false
      )
      message = "Google Play production versionCode #{version} was saved as a draft. Complete the first release submission in Play Console."
      UI.important(message)
      if ENV["GITHUB_STEP_SUMMARY"]
        File.open(ENV.fetch("GITHUB_STEP_SUMMARY"), "a") { |file| file.puts("\n#{message}") }
      end
    end
  end

  desc "Build the target Android APK and upload it to Pgyer"
  lane :release_beta do |options|
    setup_ci
    project_root, config, = release_context(options)
    android = config.fetch("android")
    unless CentralRelease.enabled?(android)
      UI.message("项目未启用 Android 发布，跳过")
      next
    end

    flavor = options[:flavor].to_s.empty? ? "production" : options[:flavor].to_s
    is_overseas = CentralRelease.truthy?(options[:is_overseas])
    branch = git_value(project_root, "rev-parse", "--abbrev-ref", "HEAD")
    commit = git_value(project_root, "rev-parse", "--short", "HEAD")

    Dir.chdir(project_root) do
      command = CentralRelease.android_flutter_command(
        config: config,
        artifact: "apk",
        flavor: flavor,
        branch: branch,
        commit: commit,
        is_overseas: is_overseas
      )
      UI.message("执行 Android Flutter 构建: #{CentralRelease.shell_join(command)}")
      sh(*command)

      next unless android.dig("pgyer", "enabled") == true

      apk_path = CentralRelease.apk_path(config: config, project_root: project_root)
      UI.user_error!("APK not found in build outputs") if apk_path.nil?
      UI.message("上传 APK: #{apk_path}")
      UI.user_error!("PGYER_API_KEY 未配置") if ENV["PGYER_API_KEY"].to_s.empty?
      sh(
        "curl --fail-with-body --silent --show-error " \
        "-F #{Shellwords.escape("file=@#{apk_path}")} " \
        "-F \"_api_key=$PGYER_API_KEY\" https://www.pgyer.com/apiv2/app/upload",
        log: false
      )
    end
  end

  desc "Build the target Android AAB and optionally upload it to Google Play"
  lane :release_aab do |options|
    setup_ci
    project_root, config, = release_context(options)
    android = config.fetch("android")
    google_play = android.fetch("google_play", {})
    unless CentralRelease.enabled?(android) && google_play["enabled"] == true
      UI.message("项目未启用 Google Play AAB 发布，跳过")
      next
    end

    is_overseas = CentralRelease.truthy?(options[:is_overseas])
    unless is_overseas
      UI.message("非海外构建，跳过 AAB")
      next
    end

    flavor = options[:flavor].to_s.empty? ? "production" : options[:flavor].to_s
    branch = git_value(project_root, "rev-parse", "--abbrev-ref", "HEAD")
    commit = git_value(project_root, "rev-parse", "--short", "HEAD")

    Dir.chdir(project_root) do
      command = CentralRelease.android_flutter_command(
        config: config,
        artifact: "appbundle",
        flavor: flavor,
        branch: branch,
        commit: commit,
        is_overseas: true
      )
      UI.message("执行 Android AAB 构建: #{CentralRelease.shell_join(command)}")
      sh(*command)

      aab_path = CentralRelease.aab_path(project_root: project_root)
      UI.user_error!("AAB not found in build outputs") if aab_path.nil?
      json_key_path = CentralRelease.resolve_path(project_root, google_play.fetch("json_key_path"))
      upload_to_play_store(
        package_name: google_play.fetch("package_name"),
        track: google_play.fetch("track", "production"),
        aab: aab_path,
        json_key: json_key_path,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
    end
  end
end

desc "Send a best-effort Feishu build notification"
lane :notify_feishu do |options|
  project_root, config, pubspec = release_context(options)
  unless config.dig("notification", "enabled") == true
    UI.message("项目未启用飞书通知，跳过")
    next
  end

  webhook = CentralRelease.notification_webhook(config: config, pubspec: pubspec)
  if webhook.nil?
    UI.message("fei_shu_webhook 未配置，跳过飞书通知")
    next
  end

  app_name = pubspec["name"].to_s
  version = pubspec["version"].to_s
  version_name, build_num = version.split("+", 2)
  flavor = options[:flavor].to_s.empty? ? "production" : options[:flavor].to_s
  job_status = ENV.fetch("JOB_STATUS", "success")
  actor = ENV.fetch("GITHUB_ACTOR", `whoami`.strip)
  branch = options[:branch].to_s
  branch = git_value(project_root, "rev-parse", "--abbrev-ref", "HEAD") if branch.empty?
  success = job_status == "success"

  testflight_error = testflight_failure_summary if job_status == "failure"
  text = if success
           "✅ 打包上传成功，快去体验吧！🚀"
         elsif testflight_error
           "❌ 上传 TestFlight 失败"
         else
           "❌ 打包失败"
         end
  content = "**#{text}**\n应用: #{app_name}\n版本: #{version_name}+#{build_num}\n分支: #{branch}\n触发人: #{actor}"
  ios_url = pubspec["ios_test_url"].to_s.strip
  android_url = pubspec["android_test_url"].to_s.strip
  content += "\n[iOS 下载地址](#{ios_url})" unless ios_url.empty?
  content += "\n[Android 下载地址](#{android_url})" unless android_url.empty?

  if testflight_error
    server, repository, run_id = ENV.values_at("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID")
    if [server, repository, run_id].all? { |value| !value.to_s.empty? }
      content += "\n[查看 Actions 运行](#{server}/#{repository}/actions/runs/#{run_id})"
    end
  end
  elements = [{ tag: "div", text: { tag: "lark_md", content: content } }]
  elements << { tag: "div", text: { tag: "plain_text", content: testflight_error } } if testflight_error

  card = {
    msg_type: "interactive",
    card: {
      elements: elements,
      header: {
        template: success ? "green" : "red",
        title: {
          tag: "plain_text",
          content: "#{success ? '🎉 ' : '🚨 '}#{flavor == 'production' ? '正式版' : '测试版'} #{app_name} 构建#{success ? '成功' : '失败'}"
        }
      }
    }
  }

  uri = URI.parse(webhook)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == "https"
  request = Net::HTTP::Post.new(uri.request_uri, { "Content-Type" => "application/json" })
  request.body = JSON.generate(card)
  response = http.request(request)
  if response.code.to_i.between?(200, 299)
    UI.success("飞书通知发送成功 ✅")
  else
    UI.error("飞书通知发送失败 ❌ HTTP #{response.code}")
  end
rescue StandardError => e
  UI.error("飞书通知异常，已忽略: #{e.class}")
end
